  static const int setMax = 8;

  List<Product> _defaultSet(List<Product> all) {
    final pool =
        dedupeVariants(all.where((p) => p.category != 'Set').toList());
    final picks = <Product>[];
    for (final c in ['Upper', 'Bottom', 'Shoes', 'Accessories']) {
      final m = pool.where((p) => p.category == c).toList();
      if (m.isNotEmpty) picks.add(m.first);
    }
    return picks;
  }

  void addToSet(Product p) {
    if (mySet.any((x) => x.id == p.id)) {
      message('Already in the set');
      return;
    }
    if (mySet.length >= setMax) {
      message('Set is full (8 items max)');
      return;
    }
    setState(() => mySet.add(p));
    message('${p.name} added to set');
  }

  void removeFromSet(Product p) {
    setState(() => mySet.removeWhere((x) => x.id == p.id));
    message('${p.name} removed from set');
  }

  void setToCart() {
    if (mySet.isEmpty) {
      message('Add products to your set first');
      return;
    }
    for (final p in mySet) {
      add(p, p.vname.isEmpty ? 'Set' : p.vname, 'One Size');
    }
  }

  Future<void> _pickForSet() {
    final pool =
        dedupeVariants(products.where((p) => p.category != 'Set').toList());
    return showModalBottomSheet(
        context: context,
        builder: (sheet) => SizedBox(
            height: 430,
            child: Column(children: [
              Padding(
                  padding: const EdgeInsets.all(14),
                  child: Text('Add product to set',
                      style: Theme.of(sheet).textTheme.titleMedium)),
              Expanded(
                  child: GridView.builder(
                      padding: const EdgeInsets.all(8),
                      gridDelegate:
                          const SliverGridDelegateWithFixedCrossAxisCount(
                              crossAxisCount: 3,
                              crossAxisSpacing: 10,
                              mainAxisSpacing: 10,
                              childAspectRatio: .72),
                      itemCount: pool.length,
                      itemBuilder: (_, i) {
                        final p = pool[i];
                        return InkWell(
                            onTap: () {
                              Navigator.pop(sheet);
                              addToSet(p);
                            },
                            child: Column(children: [
                              Expanded(child: AssetImg(p.img)),
                              Container(
                                  color: gray,
                                  padding: const EdgeInsets.all(4),
                                  child: Text('${p.name}\nTHB ${p.price}',
                                      maxLines: 2,
                                      overflow: TextOverflow.ellipsis,
                                      style: const TextStyle(fontSize: 11)))
                            ]));
                      }))
            ])));
  }

  Widget _setTile(Product p) => Stack(clipBehavior: Clip.none, children: [
        InkWell(
            onTap: () => detail(p),
            child: SizedBox(
                width: 148,
                height: 148,
                child: AssetImg(p.img, fit: BoxFit.cover))),
        Positioned(
            top: 3,
            right: 3,
            child: InkWell(
                onTap: () => removeFromSet(p),
                child: Container(
                    width: 26,
                    height: 26,
                    decoration: BoxDecoration(
                        color: Colors.white.withValues(alpha: .92),
                        shape: BoxShape.circle,
                        boxShadow: [
                          BoxShadow(
                              color: Colors.black.withValues(alpha: .25),
                              blurRadius: 4)
                        ]),
                    child: const Icon(Icons.close, size: 17))))
      ]);

  Widget _addTile() => InkWell(
      onTap: _pickForSet,
      child: Container(
          width: 148,
          height: 148,
          color: darkGray,
          alignment: Alignment.center,
          child: const Icon(Icons.add, size: 44, color: Colors.white)));

  Widget studio() {
    final recommend = dedupeVariants(
        products.where((p) => p.category != 'Set').toList());
    final total = mySet.fold<int>(0, (s, e) => s + e.price);
    return ListView(children: [
      header(),
      Padding(
          padding: const EdgeInsets.all(16),
          child: Container(
              padding: const EdgeInsets.all(14),
              color: darkGray,
              child: Wrap(
                  spacing: 10,
                  runSpacing: 10,
                  children: [
                    for (final p in mySet) _setTile(p),
                    if (mySet.length < setMax) _addTile()
                  ]))),
      Padding(
          padding: const EdgeInsets.fromLTRB(18, 4, 12, 0),
          child: Row(children: [
            const Expanded(
                child: Text('My Set', style: TextStyle(fontSize: 30))),
            IconButton(
                onPressed: () => message('Set saved to favorites'),
                icon: const Icon(Icons.favorite_border))
          ])),
      Padding(
          padding: const EdgeInsets.fromLTRB(18, 0, 18, 10),
          child:
              Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            const Text('Price'),
            Text('THB $total', style: const TextStyle(fontSize: 20))
          ])),
      Padding(
          padding: const EdgeInsets.fromLTRB(18, 0, 18, 8),
          child: Row(children: [
            Expanded(
                child: OutlinedButton(
                    onPressed: setToCart, child: const Text('PUT IN BASKET'))),
            const SizedBox(width: 24),
            Expanded(
                child: FilledButton(
                    style: FilledButton.styleFrom(
                        backgroundColor: const Color(0xFF444444)),
                    onPressed: () {
                      setToCart();
                      openBasket();
                    },
                    child: const Text('BUY NOW')))
          ])),
      const Divider(thickness: 10, color: gray),
      const Padding(
          padding: EdgeInsets.all(20),
          child: Text('Recommend', style: TextStyle(fontSize: 20))),
      cards(recommend.take(6).toList())
    ]);
  }

  Widget search() {
    return Column(children: [
      Padding(
          padding: const EdgeInsets.all(18),
          child: TextField(
              decoration: const InputDecoration(
                  prefixIcon: Icon(Icons.search),
                  hintText: 'Search fashion products',
                  border: OutlineInputBorder()),
              onChanged: (s) => setState(() => searchTerm = s))),
      Expanded(
          child: ListView(children: [
        cards(
            dedupeVariants(products)
                .where((p) =>
                    p.name.toLowerCase().contains(searchTerm.toLowerCase()))
                .toList())
      ]))
    ]);
  }

  String searchTerm = '';
  Widget profile() => ProfilePage(
      onLoggedIn: onLogin, userId: userId, onLogout: logout);
  @override
  Widget build(BuildContext context) => Scaffold(
      body: SafeArea(
          child: loading
              ? const Center(child: CircularProgressIndicator())
              : error != null
                  ? Center(
                      child: Column(mainAxisSize: MainAxisSize.min, children: [
                      Text(error!, textAlign: TextAlign.center),
                      ElevatedButton(
                          onPressed: reload, child: const Text('Retry'))
                    ]))
                  : IndexedStack(index: tab, children: [
                      home(),
                      studio(),
                      search(),
                      ListView(children: [
                        const Padding(
                            padding: EdgeInsets.all(20),
                            child:
                                Text('Saved', style: TextStyle(fontSize: 26))),
                        cards(products
                            .where((p) => saved.contains(p.id))
                            .toList())
                      ]),
                      profile()
                    ])),
      bottomNavigationBar: BottomNavBar(onTab: switchTab, currentIndex: tab));
}

// Shared bottom navigation bar. Every page pins it with its Scaffold, so it
// stays fixed in place instead of moving with the page content.
class BottomNavBar extends StatelessWidget {
  final void Function(int) onTab;
  final int currentIndex;
  const BottomNavBar({super.key, required this.onTab, this.currentIndex = 0});
  @override
  Widget build(BuildContext context) => BottomNavigationBar(
      type: BottomNavigationBarType.fixed,
      currentIndex: currentIndex,
      onTap: onTab,
      selectedItemColor: Colors.black,
      unselectedItemColor: Colors.black,
      items: const [
        BottomNavigationBarItem(
            icon: Icon(Icons.home_outlined), label: 'Home'),
        BottomNavigationBarItem(
            icon: Icon(Icons.checkroom_outlined), label: 'Style Studio'),
        BottomNavigationBarItem(icon: Icon(Icons.search), label: 'Search'),
        BottomNavigationBarItem(
            icon: Icon(Icons.favorite_border), label: 'Saved'),
        BottomNavigationBarItem(
            icon: Icon(Icons.account_circle_outlined), label: 'Profile')
      ]);
}

class Picture extends StatelessWidget {
  final double? height;
  final IconData icon;
  const Picture({super.key, this.height, this.icon = Icons.image_outlined});  @override
  Widget build(BuildContext context) => Container(
      height: height,
      color: darkGray,
      alignment: Alignment.center,
      child: Icon(icon, size: height != null ? 60 : 45, color: Colors.black));
}

class AssetImg extends StatelessWidget {
  final String asset;
  final BoxFit fit;
  const AssetImg(this.asset, {super.key, this.fit = BoxFit.cover});

  // The API stores 'products/xxx.webp'; Flutter assets live under assets/.
  static String path(String a) =>
      a.startsWith('assets/') || a.isEmpty ? a : 'assets/$a';

  @override
  Widget build(BuildContext context) => asset.isEmpty
      ? const Picture()
      : Image.asset(path(asset),
          fit: fit, errorBuilder: (_, __, ___) => const Picture());
}

class CategoryPage extends StatefulWidget {
  final String category;
  final void Function(Product, {bool set}) onProduct;
  final int fromTab;
  final void Function(int) onTab;
  const CategoryPage(
      {super.key,
      required this.category,
      required this.onProduct,
      required this.fromTab,
      required this.onTab});
  @override
  State<CategoryPage> createState() => _CategoryPageState();
}

class _CategoryPageState extends State<CategoryPage> {
  late Future<List<Product>> future;
  @override
  void initState() {
    super.initState();
    future = Api.products(category: widget.category);
  }

  @override
  Widget build(BuildContext context) => Scaffold(
      appBar: AppBar(title: Text(widget.category)),
      bottomNavigationBar:
          BottomNavBar(onTab: widget.onTab, currentIndex: widget.fromTab),
      body: FutureBuilder<List<Product>>(
          future: future,
          builder: (context, s) {
            if (!s.hasData) {
              return Center(
                  child: Text(s.hasError ? '${s.error}' : 'Loading...'));
            }
            final items = dedupeVariants(s.data!);
            return GridView.builder(
                padding: const EdgeInsets.all(18),
                itemCount: items.length,
                gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                    crossAxisCount: 2,
                    mainAxisSpacing: 15,
                    crossAxisSpacing: 15,
                    childAspectRatio: .78),
                itemBuilder: (_, i) {
                  final p = items[i];
                  return InkWell(
                      onTap: () =>
                          widget.onProduct(p, set: p.category == 'Set'),
                      child: Column(children: [
                        Expanded(child: AssetImg(p.img)),
                        Container(
                            color: gray,
                            width: double.infinity,
                            padding: const EdgeInsets.all(8),
                            child: Text('${p.name}\nTHB ${p.price}'))
                      ]));
                });
          }));
}

class ProductDetail extends StatefulWidget {
  final Product product;
  final bool isSet;
  final Set<int> savedIds;
  final void Function(Product) onSave;
  final VoidCallback onBasket;
  final void Function(Product, String) onAdd;
  final List<Product> recommendations;
  final void Function(Product, {bool set}) onProduct;
  final int fromTab;
  final void Function(int) onTab;
  const ProductDetail(
      {super.key,
      required this.product,
      required this.isSet,
      required this.savedIds,
      required this.onSave,
      required this.onAdd,
      required this.onBasket,
      required this.recommendations,
      required this.onProduct,
      required this.fromTab,
      required this.onTab});
  @override
  State<ProductDetail> createState() => _ProductDetailState();
}

class _ProductDetailState extends State<ProductDetail> {
  static const apparelSizes = ['XXS', 'XS', 'S', 'M', 'L', 'XL', 'XXL', 'XXXL'];
  static const shoeSizes = [
    'US 5', 'US 6', 'US 7', 'US 8', 'US 9', 'US 10', 'US 11', 'US 12'
  ];
  late List<String> sizeOptions;
  late String size;
  late List<Product> variants;
  int vi = 0;
  Product get cur => variants[vi];
  @override
  void initState() {
    super.initState();
    variants = variantsOf(widget.product, widget.recommendations);
    vi = variants.indexWhere((x) => x.id == widget.product.id);
    if (vi < 0) vi = 0;
    final c = widget.product.category.toLowerCase();
    if (widget.isSet || c == 'accessories' || c == 'hat') {
      // Hats and accessories (and sets) come in one size.
      sizeOptions = const [];
      size = 'One Size';
    } else if (c == 'shoes') {
      sizeOptions = shoeSizes;
      size = 'US 9';
    } else {
      sizeOptions = apparelSizes;
      size = 'M';
    }
  }

  @override
  Widget build(BuildContext context) {
    final p = cur;
    return Scaffold(
        appBar: AppBar(title: const Text(''), actions: [
          IconButton(
              onPressed: widget.onBasket,
              icon: const Icon(Icons.shopping_bag_outlined)),
          IconButton(
              onPressed: () => Navigator.push(
                  context,
                  MaterialPageRoute(
                      builder: (_) => Scaffold(
                          appBar: AppBar(title: const Text('Profile')),
                          body: const Center(
                              child: Text(
                                  'Open Profile from the bottom navigation'))))),
              icon: const Icon(Icons.account_circle_outlined))
        ]),
        body: ListView(
          children: [
            Padding(
                padding: EdgeInsets.fromLTRB(
                    0, 0, 0, widget.isSet ? 0 : 19),
                child: SizedBox(
                    height: widget.isSet ? 430 : 260,
                    width: double.infinity,
                    child: AssetImg(p.img, fit: BoxFit.cover))),
            if (!widget.isSet && variants.length > 1)
              SizedBox(
                  height: 78,
                  child: ListView.builder(
                      scrollDirection: Axis.horizontal,
                      padding: const EdgeInsets.symmetric(horizontal: 16),
                      itemCount: variants.length,
                      itemBuilder: (_, i) => InkWell(
                          onTap: () => setState(() => vi = i),
                          child: Opacity(
                              opacity: vi == i ? 1 : .55,
                              child: Container(
                                  width: 66,
                                  margin: const EdgeInsets.only(right: 10),
                                  decoration: BoxDecoration(
                                      borderRadius: BorderRadius.circular(8),
                                      border: Border.all(
                                          color: vi == i
                                              ? Colors.black
                                              : Colors.transparent,
                                          width: 2)),
                                  child: ClipRRect(
                                      borderRadius: BorderRadius.circular(6),
                                      child: AssetImg(variants[i].img))))))),
            Padding(
                padding: const EdgeInsets.symmetric(horizontal: 20),
                child: Row(children: [
                  Expanded(
                      child: Text(p.name, style: const TextStyle(fontSize: 24))),
                  IconButton(
                      icon: Icon(widget.savedIds.contains(p.id)
                          ? Icons.favorite
                          : Icons.favorite_border),
                      onPressed: () =>
                          setState(() => widget.onSave(p)))
                ])),
            if (!widget.isSet && variants.length > 1)
              const Padding(
                  padding: EdgeInsets.fromLTRB(20, 22, 20, 0),
                  child: Text('Color')),
            if (!widget.isSet && variants.length > 1)
              Padding(
                  padding: const EdgeInsets.fromLTRB(20, 8, 20, 0),
                  child: Wrap(
                      spacing: 8,
                      runSpacing: 8,
                      children: [
                        for (final v in variants)
                          ChoiceChip(
                              selected: v.id == p.id,
                              onSelected: (_) =>
                                  setState(() => vi = variants.indexOf(v)),
                              label: Text(v.vname.isEmpty ? 'Variant' : v.vname,
                                  style: const TextStyle(fontSize: 12)))
                      ])),
            if (!widget.isSet && sizeOptions.isNotEmpty) ...[
              const Padding(
                  padding: EdgeInsets.fromLTRB(20, 22, 20, 0),
                  child: Text('Size')),
              Padding(
                  padding: const EdgeInsets.fromLTRB(20, 8, 20, 0),
                  child: Wrap(
                      spacing: 10,
                      runSpacing: 10,
                      children: [
                        for (final s in sizeOptions)
                          InkWell(
                              onTap: () => setState(() => size = s),
                              child: Container(
                                  width: 70,
                                  height: 50,
                                  alignment: Alignment.center,
                                  decoration: BoxDecoration(
                                      color: gray,
                                      border: Border.all(
                                          color: size == s
                                              ? Colors.black
                                              : Colors.transparent,
                                          width: 2)),
                                  child: Text(s,
                                      style: const TextStyle(fontSize: 14))))
                      ]))
            ],
            if (!widget.isSet)
              const Padding(
                  padding: EdgeInsets.symmetric(horizontal: 20),
                  child: Text('★★★★★   5.0 (230 Review)')),
            Padding(
                padding: const EdgeInsets.all(22),
                child: Row(
                    mainAxisAlignment: MainAxisAlignment.spaceBetween,
                    children: [
                      Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            const Text('Price'),
                            Text('THB ${p.price}',
                                style: const TextStyle(fontSize: 20))
                          ]),
                      Text('${p.stock} Left',
                          style: const TextStyle(fontSize: 19))
                    ])),
            const Divider(thickness: 10, color: gray),
            if (!widget.isSet) ...[
              const Padding(
                  padding: EdgeInsets.all(22),
                  child: Text(
                      'Product Description\n\nA versatile fashion piece for everyday styling. Pick a variant above to switch colorway — the name, price and photos update instantly.\n\nMix and match this item with other pieces from our collection.',
                      style: TextStyle(fontSize: 15, height: 1.6)))
            ],
            if (widget.isSet) ...[
              const Divider(thickness: 10, color: gray),
              const Padding(
                  padding: EdgeInsets.all(20),
                  child: Text('Recommend', style: TextStyle(fontSize: 19))),
              Padding(
                  padding: const EdgeInsets.all(18),
                  child: GridView.builder(
                      shrinkWrap: true,
                      physics: const NeverScrollableScrollPhysics(),
                      itemCount: widget.recommendations
                          .where((x) => x.category != 'Set')
                          .take(6)
                          .length,
                      gridDelegate:
                          const SliverGridDelegateWithFixedCrossAxisCount(
                              crossAxisCount: 2,
                              crossAxisSpacing: 16,
                              mainAxisSpacing: 16,
                              childAspectRatio: .8),
                      itemBuilder: (_, i) {
                        final r = widget.recommendations
                            .where((x) => x.category != 'Set')
                            .elementAt(i);
                        return InkWell(
                            onTap: () => widget.onProduct(r),
                            child: Column(children: [
                              const Expanded(child: Picture()),
                              Container(
                                  width: double.infinity,
                                  color: gray,
                                  padding: const EdgeInsets.all(8),
                                  child: Text('${r.name}\nTHB ${r.price}'))
                            ]));
                      }))
            ]
          ],
        ),
        bottomNavigationBar:
            Column(mainAxisSize: MainAxisSize.min, children: [
          SafeArea(
              child: Padding(
                  padding: const EdgeInsets.all(16),
                  child: Row(children: [
                    Expanded(
                        child: OutlinedButton(
                            onPressed: () => widget.onAdd(
                                p, widget.isSet ? 'One Size' : size),
                            child: const Text('PUT IN BASKET'))),
                    const SizedBox(width: 24),
                    Expanded(
                        child: FilledButton(
                            style: FilledButton.styleFrom(
                                backgroundColor: const Color(0xFF444444)),
                            onPressed: () {
                              widget.onAdd(p, widget.isSet ? 'One Size' : size);
                              widget.onBasket();
                            },
                            child: const Text('BUY NOW')))
                  ]))),
          BottomNavBar(onTab: widget.onTab, currentIndex: widget.fromTab)
        ]));
  }
}

class ProfilePage extends StatefulWidget {
  final void Function(int) onLoggedIn;
  final VoidCallback onLogout;
  final int? userId;
  const ProfilePage(
      {super.key,
      required this.onLoggedIn,
      required this.onLogout,
      required this.userId});
  @override
  State<ProfilePage> createState() => _ProfilePageState();
}

class _ProfilePageState extends State<ProfilePage> {
  bool register = false, busy = false;
  final username = TextEditingController(),
      email = TextEditingController(),
      phone = TextEditingController(),
      password = TextEditingController(),
      confirm = TextEditingController();
  @override
  void dispose() {
    for (final c in [username, email, phone, password, confirm]) {
      c.dispose();
    }
    super.dispose();
  }

  Future<void> submit() async {
    if (register && password.text != confirm.text) {
      show('Passwords do not match');
      return;
    }
    setState(() => busy = true);
    try {
      final r = await Api.post(
          register ? '/register' : '/login',
          register
              ? {
                  'username': username.text,
                  'email': email.text,
                  'phone': phone.text,
                  'password': password.text
                }
              : {'email': email.text, 'password': password.text});
      widget.onLoggedIn(r['id']);
      show(register ? 'Registration successful' : 'Logged in successfully');
    } catch (e) {
      show(e.toString());
    } finally {
      if (mounted) setState(() => busy = false);
    }
  }

  void show(String t) =>
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(t)));
  Widget field(String label, TextEditingController controller,
          {bool secret = false}) =>
      Padding(
          padding: const EdgeInsets.only(bottom: 17),
          child:
              Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
            Text(label, style: const TextStyle(fontSize: 19)),
            const SizedBox(height: 5),
            TextField(
                controller: controller,
                obscureText: secret,
                decoration: InputDecoration(
                    hintText: 'Enter $label',
                    filled: true,
                    fillColor: gray,
                    border: OutlineInputBorder(
                        borderRadius: BorderRadius.circular(6),
                        borderSide: BorderSide.none),
                    isDense: true))
          ]));
  @override
  Widget build(BuildContext context) => ListView(children: [
        const Padding(
            padding: EdgeInsets.all(18),
            child:
                Center(child: Text('Profile', style: TextStyle(fontSize: 18)))),
        const SizedBox(height: 35),
        const Icon(Icons.account_circle_outlined, size: 90),
        if (widget.userId != null) ...[
          Padding(
              padding: const EdgeInsets.only(top: 4),
              child: TextButton(
                  onPressed: widget.onLogout,
                  child: const Text('Logout'))),
          // Orders live in the orders/order_items tables.
          FutureBuilder<List<Map<String, dynamic>>>(
              future: Api.orders(widget.userId!),
              builder: (context, s) {
                if (!s.hasData) {
                  return const Padding(
                      padding: EdgeInsets.all(22),
                      child: Center(child: CircularProgressIndicator()));
                }
                final orders = s.data!;
                return Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 26),
                    child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          const Text('My Orders',
                              style: TextStyle(fontSize: 21)),
                          const SizedBox(height: 12),
                          if (orders.isEmpty)
                            const Padding(
                                padding: EdgeInsets.symmetric(vertical: 16),
                                child: Text(
                                    'No orders yet — your purchases will appear here.')),
                          for (final o in orders)
                            Container(
                                width: double.infinity,
                                margin: const EdgeInsets.only(bottom: 12),
                                padding: const EdgeInsets.all(12),
                                color: gray,
                                child: Column(
                                    crossAxisAlignment:
                                        CrossAxisAlignment.start,
                                    children: [
                                      Text('Order #${o['id']}',
                                          style: const TextStyle(
                                              fontWeight: FontWeight.bold)),
                                      Text('${o['created_at']}'),
                                      for (final it in (o['items'] as List<dynamic>)
                                          .map((e) =>
                                              Map<String, dynamic>.from(e)))
                                        Text(
                                            '${it['name']} x${it['quantity']} (${it['size']})',
                                            softWrap: true),
                                      Text('Address: ${o['address']}'),
                                      Text('Total: THB ${o['total']}')
                                    ]))
                        ]));
              })
        ],
        Padding(
            padding: const EdgeInsets.fromLTRB(47, 45, 47, 20),
            child: Column(children: [
              if (register) field('Username', username),
              field('Email', email),
              if (register) field('Phone Number', phone),
              field('Password', password, secret: true),
              if (register) field('Confirm Password', confirm, secret: true),
              SizedBox(
                  width: 160,
                  child: FilledButton(
                      style: FilledButton.styleFrom(
                          backgroundColor: const Color(0xFF444444)),
                      onPressed: busy ? null : submit,
                      child: Text(register ? 'Register' : 'Login'))),
              TextButton(
                  onPressed: () => setState(() => register = !register),
                  child: Text(
                      register ? 'Already Have Account?' : 'New? Register',
                      style: const TextStyle(color: Colors.grey)))
            ]))
      ]);
}

class BasketPage extends StatefulWidget {
  final List<CartItem> cart;
  final List<Product> products;
  final int? userId;
  final VoidCallback onChanged;
  final void Function(Product, {bool set}) onProduct;
  final int fromTab;
  final void Function(int) onTab;
  const BasketPage(
      {super.key,
      required this.cart,
      required this.products,
      required this.userId,
      required this.onChanged,
      required this.onProduct,
      required this.fromTab,
      required this.onTab});
  @override
  State<BasketPage> createState() => _BasketPageState();
}

class _BasketPageState extends State<BasketPage> {
  final address = TextEditingController();
  bool busy = false;
  @override
  void dispose() {
    address.dispose();
    super.dispose();
  }

  int get subtotal => widget.cart
      .where((e) => e.selected)
      .fold(0, (s, e) => s + e.product.price * e.quantity);
  void update() {
    setState(() {});
    widget.onChanged();
  }

  // Quantity changes and removals are written back to cart_items.
  void changeQty(CartItem e, int delta) {
    final q = e.quantity + delta;
    if (q < 1 || q > e.product.stock) return;
    e.quantity = q;
    update();
    if (widget.userId != null && e.dbId != null) {
      Api.updateCart(e.dbId!, q).catchError((_) => <String, dynamic>{});
    }
  }

  Future<void> checkout() async {
    final selected = widget.cart.where((e) => e.selected).toList();
    if (selected.isEmpty || address.text.trim().isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('Select items and enter an address')));
      return;
    }
    setState(() => busy = true);
    try {
      final result = await Api.post('/orders', {
        'user_id': widget.userId,
        'address': address.text,
        'items': selected
            .map((e) => {
                  'product_id': e.product.id,
                  'quantity': e.quantity,
                  'size': e.size,
                  'color': e.color
                })
            .toList()
      });
      final dbIds = [for (final e in selected) if (e.dbId != null) e.dbId!];
      widget.cart.removeWhere((e) => e.selected);
      update();
      // Checked-out rows are removed from cart_items too.
      if (widget.userId != null) {
        for (final id in dbIds) {
          Api.removeCart(id).catchError((_) => <String, dynamic>{});
        }
      }
      if (mounted) {
        showDialog(
            context: context,
            builder: (_) => AlertDialog(
                    title: const Text('Order placed'),
                    content: Text(
                        'Order #${result['order_id']}\nTotal THB ${result['total']}'),
                    actions: [
                      TextButton(
                          onPressed: () => Navigator.pop(context),
                          child: const Text('OK'))
                    ]));
      }
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context)
            .showSnackBar(SnackBar(content: Text('$e')));
      }
    } finally {
      if (mounted) setState(() => busy = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final similar = dedupeVariants(
            widget.products.where((p) => p.category != 'Set').toList())
        .take(6)
        .toList();
    return Scaffold(
      appBar: AppBar(title: const Text('Basket'), centerTitle: true),
      bottomNavigationBar: BottomNavBar(onTab: widget.onTab, currentIndex: widget.fromTab),
      body: ListView(children: [
        Container(
            color: gray,
            padding: const EdgeInsets.all(6),
            child: Column(
                children: widget.cart
                    .map((e) => Container(
                        color: Colors.white,
                        margin: const EdgeInsets.only(bottom: 12),
                        padding: const EdgeInsets.all(8),
                        child: Row(children: [
                          ClipRRect(
                              borderRadius: BorderRadius.circular(4),
                              child: SizedBox(
                                  width: 90,
                                  height: 85,
                                  child:
                                      AssetImg(e.product.img, fit: BoxFit.cover))),
                          const SizedBox(width: 8),
                          Expanded(
                              child: Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                Text(e.product.name,
                                    maxLines: 2,
                                    overflow: TextOverflow.ellipsis,
                                    style: const TextStyle(fontSize: 20)),
                                Text(e.color),
                                Text('${e.product.price} THB   ${e.size}'),
                                Row(children: [
                                  IconButton(
                                      onPressed: () => changeQty(e, -1),
                                      icon: const Icon(
                                          Icons.remove_circle_outline)),
                                  Text('${e.quantity}'),
                                  IconButton(
                                      onPressed: () => changeQty(e, 1),
                                      icon:
                                          const Icon(Icons.add_circle_outline))
                                ])
                              ])),
                          Column(children: [
                            Checkbox(
                                value: e.selected,
                                onChanged: (v) {
                                  e.selected = v ?? false;
                                  update();
                                }),
                            IconButton(
                                onPressed: () {
                                  widget.cart.remove(e);
                                  update();
                                  if (widget.userId != null &&
                                      e.dbId != null) {
                                    Api.removeCart(e.dbId!).catchError((_) => <String, dynamic>{});
                                  }
                                },
                                icon: const Icon(Icons.delete_outline))
                          ])
                        ])))
                    .toList())),
        Padding(
            padding: const EdgeInsets.all(18),
            child:
                Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
              const Text('Basket', style: TextStyle(fontSize: 24)),
              const SizedBox(height: 20),
              Text(
                  'Subtotal                                       $subtotal THB'),
              const Text(
                  'Delivery fee                                      0 THB'),
              Text(
                  'Total price                                      $subtotal THB'),
              const SizedBox(height: 20),
              TextField(
                  controller: address,
                  decoration: const InputDecoration(
                      labelText: 'Location / Address',
                      hintText: 'Enter delivery address',
                      border: OutlineInputBorder())),
              const SizedBox(height: 20),
              Row(children: [
                Expanded(
                    child: OutlinedButton(
                        onPressed: () => Navigator.pop(context),
                        child: const Text('Continue Shopping'))),
                const SizedBox(width: 15),
                Expanded(
                    child: FilledButton(
                        style: FilledButton.styleFrom(
                            backgroundColor: const Color(0xFF444444)),
                        onPressed: busy ? null : checkout,
                        child: const Text('Checkout')))
              ])
            ])),
        const Divider(thickness: 12, color: gray),
        const Padding(
            padding: EdgeInsets.all(20),
            child: Text('Similar product', style: TextStyle(fontSize: 19))),
        GridView.builder(
            shrinkWrap: true,
            physics: const NeverScrollableScrollPhysics(),
            padding: const EdgeInsets.all(20),
            itemCount: similar.length,
            gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                crossAxisCount: 2,
                crossAxisSpacing: 16,
                mainAxisSpacing: 18,
                childAspectRatio: .8),
            itemBuilder: (_, i) {
              final p = similar[i];
              return InkWell(
                  onTap: () => widget.onProduct(p),
                  child: Column(children: [
                    Expanded(child: AssetImg(p.img)),
                    Container(
                        width: double.infinity,
                        color: gray,
                        padding: const EdgeInsets.all(8),
                        child: Text('${p.name}\nTHB ${p.price}'))
                  ]));
            })
      ]));
  }
}
