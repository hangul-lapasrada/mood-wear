import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:http/http.dart' as http;

// Android emulator: 10.0.2.2. iOS simulator: localhost.
const apiBase =
    String.fromEnvironment('API_URL', defaultValue: 'http://10.0.2.2:8000');
const gray = Color(0xFFD9D9D9);
const darkGray = Color(0xFF999999);
void main() => runApp(const MoodWearApp());

class Product {
  final int id, price, stock;
  final String name, category, img, vgroup, vname;
  Product.fromJson(Map<String, dynamic> j)
      : id = j['id'],
        price = j['price'],
        stock = j['stock'] ?? 0,
        name = j['name'] ?? '',
        category = j['category'] ?? '',
        img = j['img'] ?? '',
        vgroup = j['vgroup'] ?? '',
        vname = j['vname'] ?? '';
}

// Rows of the same variant group share one product card in listings.
List<Product> dedupeVariants(List<Product> list) {
  final seen = <String>{};
  return [
    for (final p in list)
      if (seen.add(p.vgroup.isEmpty ? 'id-${p.id}' : p.vgroup)) p
  ];
}

List<Product> variantsOf(Product p, List<Product> all) {
  if (p.vgroup.isEmpty) return [p];
  final v = all.where((x) => x.vgroup == p.vgroup).toList();
  return v.length <= 1 ? [p] : v;
}

class CartItem {
  final Product product;
  String color, size;
  int quantity;
  bool selected = true;
  // Non-null when this row exists in the backend cart_items table.
  int? dbId;
  CartItem(this.product, this.color, this.size, {this.quantity = 1});
}

class Api {
  static Future<List<Product>> products(
      {String? category, String? search}) async {
    final q = <String, String>{};
    if (category != null && category != 'New Arrival') q['category'] = category;
    if (search != null && search.isNotEmpty) q['search'] = search;
    final uri = Uri.parse('$apiBase/products')
        .replace(queryParameters: q.isEmpty ? null : q);
    final r = await http.get(uri).timeout(const Duration(seconds: 8));
    if (r.statusCode != 200) {
      throw Exception('Cannot load products: ${r.statusCode}');
    }
    return (jsonDecode(r.body) as List)
        .map((e) => Product.fromJson(e))
        .toList();
  }

  static Future<Map<String, dynamic>> post(
      String path, Map<String, dynamic> body) async {
    final r = await http
        .post(Uri.parse('$apiBase$path'),
            headers: {'Content-Type': 'application/json'},
            body: jsonEncode(body))
        .timeout(const Duration(seconds: 8));
    if (r.statusCode >= 400) {
      final j = jsonDecode(r.body);
      throw Exception(j['detail'] ?? 'Request failed');
    }
    return Map<String, dynamic>.from(jsonDecode(r.body));
  }

  /// Generic JSON call for PUT/DELETE endpoints.
  static Future<Map<String, dynamic>> send(String method, String path,
      {Map<String, dynamic>? body}) async {
    final req = http.Request(method, Uri.parse('$apiBase$path'));
    if (body != null) {
      req.headers['Content-Type'] = 'application/json';
      req.body = jsonEncode(body);
    }
    final streamed =
        await req.send().timeout(const Duration(seconds: 8));
    final r = await http.Response.fromStream(streamed);
    if (r.statusCode >= 400) {
      String detail = 'Request failed (${r.statusCode})';
      try {
        detail = jsonDecode(r.body)['detail'] ?? detail;
      } catch (_) {}
      throw Exception(detail);
    }
    return r.body.isEmpty
        ? {}
        : Map<String, dynamic>.from(jsonDecode(r.body));
  }

  static List<Map<String, dynamic>> _list(String body) => (jsonDecode(body) as List)
      .map((e) => Map<String, dynamic>.from(e))
      .toList();

  // ---- Backend-backed basket (cart_items table) ----
  static Future<List<Map<String, dynamic>>> cart(int userId) async {
    final r = await http.get(Uri.parse('$apiBase/cart').replace(
            queryParameters: {'user_id': '$userId'}))
        .timeout(const Duration(seconds: 8));
    if (r.statusCode != 200) throw Exception('Cannot load basket');
    return _list(r.body);
  }

  static Future<Map<String, dynamic>> addToCart(int userId, int productId,
          int quantity, String size, String color) async =>
      send('POST', '/cart', body: {
        'user_id': userId,
        'product_id': productId,
        'quantity': quantity,
        'size': size,
        'color': color
      });

  static Future<Map<String, dynamic>> updateCart(int itemId, int quantity) =>
      send('PUT', '/cart/$itemId', body: {'quantity': quantity});

  static Future<Map<String, dynamic>> removeCart(int itemId) =>
      send('DELETE', '/cart/$itemId');

  // ---- Backend-backed favorites (favorites table) ----
  static Future<List<Map<String, dynamic>>> favorites(int userId) async {
    final r = await http
        .get(Uri.parse('$apiBase/favorites')
            .replace(queryParameters: {'user_id': '$userId'}))
        .timeout(const Duration(seconds: 8));
    if (r.statusCode != 200) throw Exception('Cannot load favorites');
    return _list(r.body);
  }

  static Future<Map<String, dynamic>> addFavorite(int userId, int productId) =>
      send('POST', '/favorites',
          body: {'user_id': userId, 'product_id': productId});

  static Future<Map<String, dynamic>> removeFavorite(
          int userId, int productId) =>
      send('DELETE', '/favorites/$userId/$productId');

  // ---- Purchase history (orders + order_items tables) ----
  static Future<List<Map<String, dynamic>>> orders(int userId) async {
    final r = await http.get(Uri.parse('$apiBase/orders').replace(
            queryParameters: {'user_id': '$userId'}))
        .timeout(const Duration(seconds: 8));
    if (r.statusCode != 200) throw Exception('Cannot load orders');
    return _list(r.body);
  }
}

class MoodWearApp extends StatelessWidget {
  const MoodWearApp({super.key});
  @override
  Widget build(BuildContext context) => MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Mood Wear',
      theme: ThemeData(
          useMaterial3: true,
          scaffoldBackgroundColor: Colors.white,
          colorSchemeSeed: Colors.grey,
          appBarTheme: const AppBarTheme(
              backgroundColor: Colors.white, foregroundColor: Colors.black)),
      home: const ShopShell());
}

class ShopShell extends StatefulWidget {
  const ShopShell({super.key});
  @override
  State<ShopShell> createState() => _ShopShellState();
}

class _ShopShellState extends State<ShopShell> {
  int tab = 0;
  List<Product> products = [];
  bool loading = true;
  String? error;
  final List<CartItem> cart = [];
  final Set<int> saved = {};
  List<Product> mySet = [];
  int? userId;
  @override
  void initState() {
    super.initState();
    reload();
  }

  Future<void> reload() async {
    setState(() {
      loading = true;
      error = null;
    });
    try {
      final p = await Api.products();
      if (mounted) {
        if (mySet.isEmpty) mySet = _defaultSet(p);
        setState(() {
          products = p;
          loading = false;
        });
      }
    } catch (e) {
      if (mounted) {
        setState(() {
          loading = false;
          error = e.toString();
        });
      }
    }
  }

  void message(String text) {
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(text)));
  }

  void toggleSave(Product p) {
    final added = saved.add(p.id);
    setState(() {
      if (!added) saved.remove(p.id);
    });
    // Write-through to the favorites table when signed in.
    if (userId != null) {
      (added
              ? Api.addFavorite(userId!, p.id)
              : Api.removeFavorite(userId!, p.id))
          .catchError((_) => <String, dynamic>{});
    }
  }

  CartItem cartItemFromDb(Map<String, dynamic> row) => CartItem(
      Product.fromJson(Map<String, dynamic>.from(row['product'])),
      row['color'] ?? '',
      row['size'] ?? 'M',
      quantity: row['quantity'] ?? 1)
    ..dbId = row['id'];

  void add(Product p, String color, String size) {
    setState(() {
      final match = cart
          .where(
              (x) => x.product.id == p.id && x.color == color && x.size == size)
          .toList();
      if (match.isNotEmpty) {
        if (match.first.quantity < p.stock) {
          match.first.quantity++;
        } else {
          message('Only ${p.stock} left');
          return;
        }
      } else {
        cart.add(CartItem(p, color, size));
      }
    });
    // Mirror the local basket row into cart_items when signed in.
    if (userId != null) {
      final item = cart.firstWhere((x) =>
          x.product.id == p.id && x.color == color && x.size == size);
      Api.addToCart(userId!, p.id, item.quantity, size, color)
          .then((res) => item.dbId ??= res['id'])
          .catchError((_) => <String, dynamic>{});
    }
    message('Added to basket');
  }

  /// After login: push guest basket/favorites into the DB, then load the
  /// account's persisted basket and favorites back into the app state.
  Future<void> onLogin(int id) async {
    setState(() => userId = id);
    try {
      final dbRows = await Api.cart(id);
      for (final item in cart) {
        final exists = dbRows.any((r) =>
            r['product']['id'] == item.product.id &&
            r['size'] == item.size &&
            r['color'] == item.color);
        if (!exists) {
          final res = await Api.addToCart(
              id, item.product.id, item.quantity, item.size, item.color);
          item.dbId = res['id'];
        }
      }
      final dbFavs = (await Api.favorites(id)).map((r) => r['id'] as int);
      for (final fid in saved) {
        if (!dbFavs.contains(fid)) await Api.addFavorite(id, fid);
      }
      final fresh = await Api.cart(id);
      setState(() {
        cart
          ..clear()
          ..addAll(fresh.map(cartItemFromDb));
        saved.addAll(dbFavs);
      });
    } catch (e) {
      message('Account sync failed: $e');
    }
  }

  /// Back to guest state: rows backed by the DB stay in the DB (they reload
  /// on the next login), pure in-memory rows remain on screen.
  void logout() {
    setState(() {
      userId = null;
      cart.removeWhere((e) => e.dbId != null);
      saved.clear();
    });
  }

  void detail(Product p, {bool set = false}) => Navigator.push(
      context,
      MaterialPageRoute(
          builder: (_) => ProductDetail(
              product: p,
              isSet: set,
              savedIds: saved,
              onSave: (prod) => toggleSave(prod),
              onAdd: (prod, size) => add(prod, prod.vname, size),
              onBasket: openBasket,
              recommendations: products,
              onProduct: detail,
              fromTab: tab,
              onTab: switchTab)));
  // Switch tabs from any page: close pushed pages first, then show the tab.
  void switchTab(int i) {
    Navigator.of(context).popUntil((r) => r.isFirst);
    setState(() => tab = i);
  }

  void openBasket() => Navigator.push(
      context,
      MaterialPageRoute(
          builder: (_) => BasketPage(
              cart: cart,
              products: products,
              userId: userId,
              onChanged: () => setState(() {}),
              onProduct: detail,
              fromTab: tab,
              onTab: switchTab)));
